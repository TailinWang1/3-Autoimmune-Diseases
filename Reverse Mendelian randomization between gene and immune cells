#1
a <- extract_instruments(outcomes = "ebi-a-GCST90028998", 
                         p1 = 5e-8,  # 更宽松的显著性阈值
                         clump = FALSE)
head(a)
#补充ld_clump需要的三列
a$id<-a$id.exposure # id列用于区分是单个或多个来源的gwas数据，clump按照单个gwas数据进行
a$rsid<-a$SNP
a$pval<-a$pval.exposure
b<- ieugwasr::ld_clump_local(
  dat=a,
  clump_kb = 10000,
  clump_r2 = 0.01, 
  clump_p = 1,
  plink_bin="C:/Users/tailinwang/Documents/plink_win64_20241022/plink.exe",
  bfile ="C:/Users/tailinwang/Documents/g1000_eur/g1000_eur")
c<-subset(a,SNP%in%b$rsid)
outcome_dat <- extract_outcome_data(snps = c$SNP, outcomes = 'eqtl-a-ENSG00000125995')
dat<- harmonise_data(exposure_dat =c,  outcome_dat = outcome_dat)
res<- mr(dat)
write.csv(dat,"ebi-a-GCST90028998.csv")
write.csv(res,"ebi-a-GCST90028998-res.csv")
pleio<- mr_pleiotropy_test(dat)
het<- mr_heterogeneity(dat)
OR <-generate_odds_ratios(res)
